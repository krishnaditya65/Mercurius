# --- Rust ---
target/
Cargo.lock
!services/*/Cargo.lock

# --- Go ---
/services/*/bin/
*.test
*.out
# `go build ./...` run from a service root drops an extensionless binary
# named after its cmd/ dir (e.g. `server`) right there — never commit it.
services/*/server

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
build/
.turbo/

# --- Tauri ---
apps/terminal/src-tauri/target/

# --- Python ---
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
*.egg-info/

# --- Env / secrets ---
.env
.env.local
*.pem
*.key

